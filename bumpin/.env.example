# Copy to .env. Everything is optional: with no key the app runs fully, using
# rule-based fallbacks instead of the AI.

# AI provider: groq, openai or anthropic. Leave blank to run without AI.
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override, e.g. openai/gpt-oss-120b on Groq.
LLM_MODEL=
# on = cache AI answers in data/llm_cache so repeat runs are identical and free.
LLM_CACHE=on

# Optional: TypeSafe Jev as the email classifier.
JEV_API_KEY=

# Optional: a real mailbox. Every new email sent to it becomes a ticket, attachments included.
# For Gmail: turn on 2-Step Verification, then create an App Password and use it here.
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_POLL_SECONDS=15

# mock = sending only marks the email as sent. demo = also delivers to DEMO_RECIPIENT only.
EMAIL_MODE=mock
DEMO_RECIPIENT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
